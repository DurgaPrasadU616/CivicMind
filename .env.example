# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local or remote PostgreSQL database connection URI
# Example: postgresql://username:password@localhost:5432/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/civicmind

# Frontend Client URL (for CORS allowance)
FRONTEND_URL=http://localhost:3000

# Gemini AI Models
GEMINI_MODEL=gemini-2.5-flash
MEDIA_ANALYSIS_MODEL=gemini-2.5-flash
INVESTIGATION_MODEL=gemini-2.5-flash

# Media Storage Configuration
# local | imagekit | r2 | s3
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_DIR=./uploads

# ImageKit Configuration (free tier, no credit card required)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Cloudflare R2 / S3 Configuration (optional alternative)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Shared persistence for presigned upload tickets (required in production)
# Example: rediss://default:password@your-upstash-host:6379
REDIS_URL=

# Durable serverless background jobs (QStash)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Public origin used to build the QStash destination URL
PUBLIC_BASE_URL=
# Optional explicit destination override
QSTASH_MEDIA_JOB_URL=

# Protects GET/POST /api/internal/jobs/media-recover (Vercel Cron sends Bearer <CRON_SECRET>)
CRON_SECRET=
